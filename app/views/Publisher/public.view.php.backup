<?php
// Check if there's an error
if (isset($error)) {
    echo '<div class="error-message">' . htmlspecialchars($error) . '</div>';
    exit;
}

// Variables are already extracted from $data array by Controller::view()
// $publisher, $profile, $galleries, $upcomingEvents, $pastEvents are available

// Set defaults if not provided
$galleries = $galleries ?? [];
$upcomingEvents = $upcomingEvents ?? [];
$pastEvents = $pastEvents ?? [];

// Helper function for safe output
function safeOutput($value, $default = '') {
    return !empty($value) ? htmlspecialchars($value) : $default;
}

// Prepare display values
$orgName = safeOutput($publisher->society_name, 'Organization');
$university = safeOutput($publisher->university, 'University');
$faculty = safeOutput($publisher->faculty, 'Faculty');
$email = safeOutput($publisher->email);
$phone = safeOutput($publisher->phone);
$countryCode = safeOutput($publisher->country_code, '+94');

// Profile data
$orgType = safeOutput($profile->org_type ?? null, 'Student Organization');
$headline = safeOutput($profile->headline ?? null, 'Welcome to our organization');
$bio = safeOutput($profile->bio ?? null, 'This organization is dedicated to fostering innovation and excellence.');
$mission = safeOutput($profile->mission ?? null);
$address = safeOutput($profile->address ?? null);
$establishedYear = safeOutput($profile->established_year ?? null);
$memberCount = safeOutput($profile->member_count ?? null);
$logoUrl = safeOutput($profile->logo_url ?? null, 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=cover&w=400&q=80');
$coverPhotoUrl = safeOutput($profile->cover_photo_url ?? null, 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=cover&w=1200&q=80');

// Social media
$website = $profile->website ?? null;
$facebook = $profile->facebook ?? null;
$instagram = $profile->instagram ?? null;
$linkedin = $profile->linkedin ?? null;
$twitter = $profile->twitter ?? null;
$discord = $profile->discord ?? null;
$youtube = $profile->youtube ?? null;

// Preferences/Tags
$preferences = isset($profile->preferences) ? json_decode($profile->preferences, true) : [];
?>
